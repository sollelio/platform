# Copia para .env e preenche. NUNCA commitar valores reais.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# production | test | development — também etiqueta a analytics
VITE_APP_ENV=test
VITE_NOME_PRODUTO=

# Analytics de produto (PostHog, projecto UE). Sem chave = desligada.
# Um projecto por ambiente: a chave de TEST nunca é a de PROD.
# `npm run dev` nunca envia para production, mesmo com a chave de produção.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_ANALYTICS_DESLIGADA=true
